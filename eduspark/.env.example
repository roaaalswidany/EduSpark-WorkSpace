# eduspark/.env.local  (copy this file, then fill the values)

# Database (must match eduspark-infra/.env)
DATABASE_URL="postgresql://eduspark:CHANGE_ME@localhost:5432/eduspark"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 48
NEXTAUTH_SECRET="CHANGE_ME_MIN_32_CHARS"

# Redis (rate limiting + cache)
REDIS_URL="redis://:CHANGE_ME@localhost:6379"

# Chat microservice
NEXT_PUBLIC_CHAT_SERVER_URL="http://localhost:3001"
# Must equal INTERNAL_API_SECRET in eduspark-chat-server/.env
INTERNAL_API_SECRET="CHANGE_ME_MIN_16_CHARS"

# AI providers
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Object storage (MinIO in dev)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET_NAME="eduspark"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"

# Test-only HTTP endpoints under /api/qa/* (keep unset in production)
# ENABLE_QA_ROUTES="true"

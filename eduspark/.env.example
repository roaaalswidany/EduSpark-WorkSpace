# eduspark/.env.local  (copy this file to .env.local and fill in the values)
# Never commit real secrets. Generate secrets with: openssl rand -base64 32

# ── Database & cache ───────────────────────────────────────────
DATABASE_URL="postgresql://eduspark:CHANGE_ME@localhost:5432/eduspark"
REDIS_URL="redis://:CHANGE_ME@localhost:6379"

# ── Auth ───────────────────────────────────────────────────────
NEXTAUTH_SECRET="CHANGE_ME_MIN_32_CHARS"      # must equal JWT_SECRET in eduspark-chat-server
NEXTAUTH_URL="http://localhost:3000"

# ── Chat server ────────────────────────────────────────────────
NEXT_PUBLIC_CHAT_SERVER_URL="http://localhost:3001"
INTERNAL_API_SECRET="CHANGE_ME_MIN_16_CHARS"  # must equal INTERNAL_API_SECRET in eduspark-chat-server

# ── File storage (any S3-compatible server, e.g. MinIO) ────────
# The browser uploads directly to this endpoint: it must be reachable from users
# and allow CORS (PUT) from your site.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_BUCKET_NAME="eduspark-uploads"

# ── Rate limiting ──────────────────────────────────────────────
# What happens when Redis is unreachable:
#   false (default) → fail OPEN : requests are allowed (best for local dev / availability)
#   true            → fail CLOSED: every rate-limited action is refused, INCLUDING login and
#                     sign-up, until Redis is back (best for production security).
# Set it to "true" in production only if Redis is monitored and highly available.
RATE_LIMIT_FAIL_CLOSED="false"

# ── Optional integrations (features degrade gracefully when empty) ──
GEMINI_API_KEY=""
VIRUSTOTAL_API_KEY=""

# ── Email (EmailJS first, SMTP as fallback) ────────────────────
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="EduSpark <no-reply@example.com>"
REQUIRE_EMAIL_VERIFICATION="false"

# ── Bootstrap / seed (leave empty unless you run them) ─────────
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""          # min. 12 chars, never the public demo password
SEED_PASSWORD=""           # required for any non-local seed
SEED_PROTECTED_EMAILS=""   # comma-separated accounts the seed must never delete
ENABLE_QA_ROUTES="false"   # keep false in production
# PRISMA_ENV_FILE=".env.test"   # point Prisma CLI at the test database

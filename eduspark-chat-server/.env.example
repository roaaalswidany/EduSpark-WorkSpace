# eduspark-chat-server/.env  (copy this file, then fill the values)
NODE_ENV="development"
PORT=3001

# MUST be identical to NEXTAUTH_SECRET in eduspark/.env.local (min 32 chars)
JWT_SECRET="CHANGE_ME_MIN_32_CHARS"

DATABASE_URL="postgresql://eduspark:CHANGE_ME@localhost:5432/eduspark"
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="CHANGE_ME"

NEXTJS_APP_URL="http://localhost:3000"
# MUST be identical to INTERNAL_API_SECRET in eduspark/.env.local (min 16 chars)
INTERNAL_API_SECRET="CHANGE_ME_MIN_16_CHARS"

MAX_MESSAGES_PER_MINUTE=60
MAX_CONNECTIONS_PER_USER=5
LOG_LEVEL="info"
